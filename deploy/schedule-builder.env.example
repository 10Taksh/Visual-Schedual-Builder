# Copied to /etc/schedule-builder.env by deploy/setup.sh. Keep it readable by root only.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

FLASK_ENV=production

# SQLite on the VM's persistent disk (default). The directory is created for you.
DATABASE_PATH=/var/lib/schedule-builder/schedule.db

# To use Postgres instead, comment DATABASE_PATH out and set this. Both postgres:// and
# postgresql:// URLs are accepted; the app routes them to the psycopg 3 driver.
# DATABASE_URL=postgresql://schedule:password@localhost/schedule

# gunicorn sizing. 1 worker is right for the 1 GB Always Free shape; 2 for anything bigger.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
