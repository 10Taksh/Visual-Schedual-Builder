[Unit]
Description=Visual Schedule Builder (gunicorn)
After=network.target

[Service]
User=schedule
Group=schedule
WorkingDirectory=/opt/schedule-builder
EnvironmentFile=/etc/schedule-builder.env
# 2 workers x 4 threads is plenty for a team-sized app; SQLite serialises writes,
# and db.py sets a busy timeout so concurrent saves wait rather than fail.
ExecStart=/opt/schedule-builder/.venv/bin/gunicorn wsgi:app \
    --bind 127.0.0.1:8000 \
    --workers 2 --threads 4 \
    --timeout 60 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3

# Hardening: the service can only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/schedule-builder

[Install]
WantedBy=multi-user.target
